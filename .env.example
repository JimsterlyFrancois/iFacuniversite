# API defaults to port 3434; Vite serves the interface on port 3435.
PORT=3434
NODE_ENV=development

# Neon PostgreSQL: use the pooled connection string for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional direct connection for controlled migrations and maintenance.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PG_POOL_MAX=1

APP_BASE_URL=http://localhost:3435

# SMTP used by the Express password-recovery email flow.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key
MAIL_FROM=your-verified-sender-address

ADMIN_EMAIL=your-address@example.com

# Supabase Auth and private Storage remain separate from the Neon application database.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-auth-key
# Server-only secret. Never expose it to the browser or use a VITE_ prefix.
SUPABASE_SECRET_KEY=your-server-side-secret-key
SUPABASE_STORAGE_BUCKET=ifac-documents
SUPABASE_ANNOUNCEMENTS_BUCKET=ifac-announcements

# Optional account allowed to manage announcement cover images.
IFAC_OWNER_EMAIL=
