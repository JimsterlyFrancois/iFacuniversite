# Serveur API
PORT=3434
NODE_ENV=development
APP_BASE_URL=http://localhost:3435

# Supabase PostgreSQL : URI de connexion de la base, utilisée UNIQUEMENT par le serveur Express.
# Récupérer l'URI dans Supabase > Project Settings > Database / Connect.
# Pour un déploiement serverless, choisir le type de connexion/pooler recommandé par Supabase.
# Ne jamais utiliser cette URI dans une variable VITE_* ou dans le code du navigateur.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# E-mail SMTP (facultatif tant que l'envoi d'e-mails n'est pas activé).
# Pour Gmail, utiliser un mot de passe d'application, jamais le mot de passe principal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=your-address@gmail.com

# L'adresse vérifiée correspondante reçoit le rôle administrateur à l'inscription.
ADMIN_EMAIL=your-address@gmail.com
