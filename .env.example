# API defaults to port 3434; set PORT only when deployment platform requires it.
PORT=3434
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
APP_BASE_URL=http://localhost:3435

# SMTP is mandatory for registration/email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# The matching verified address receives the admin role at registration.
ADMIN_EMAIL=
