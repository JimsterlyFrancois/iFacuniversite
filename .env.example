# API defaults to port 3434; set PORT only when deployment platform requires it.
PORT=3434
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
APP_BASE_URL=http://localhost:3435

# Brevo SMTP: use the SMTP login and SMTP key (NOT the Brevo API key).
# Verify the sender address in Brevo before sending production emails.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=your-verified-sender-address

# The matching verified address receives the admin role at registration.
ADMIN_EMAIL=your-address@gmail.com

# Supabase Storage: create a PRIVATE bucket named ifac-documents.
# Prefer the new server-only secret API key. The legacy service-role key is a fallback.
# Never expose either key to the browser or use a VITE_ prefix.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your-server-side-secret-key
# SUPABASE_SERVICE_ROLE_KEY=legacy-server-side-service-role-key
SUPABASE_STORAGE_BUCKET=ifac-documents
