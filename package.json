{
  "name": "ifacuniversite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base de travail de l'application universitaire iFacuniversite",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "android:configure-release": "node scripts/configure-android-release.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "pg": "^8.16.3",
    "bcryptjs": "^3.0.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.4.0",
    "multer": "^2.0.2",
    "dotenv": "^16.6.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/filesystem": "^8.0.0",
    "@capawesome/capacitor-live-update": "^8.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0",
    "@capacitor/cli": "^8.0.0"
  }
}
